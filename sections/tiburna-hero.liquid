<section class="tib-hero{% if section.settings.layout == 'full' %} tib-hero--full{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="tib-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="tib-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 class="tib-heading">{{ section.settings.heading }}</h1>
    <span class="tib-goldline"></span>
    {%- if section.settings.text != blank -%}
      <div class="tib-text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="tib-hero__actions">
        <a
          class="button button--primary"
          {% if section.settings.button_link != blank %}
            href="{{ section.settings.button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{- section.settings.button_label | escape -}}
        </a>
      </div>
    {%- endif -%}
  </div>
  <div class="tib-hero__media tib-media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'auto',
          image_size: '2400x'
      }}
    {%- else -%}
      {%- liquid
        assign media_sizes = '(min-width: 990px) 50vw, 100vw'
        if section.settings.layout == 'full'
          assign media_sizes = '100vw'
        endif
      -%}
      {%- render 'tib-image',
        image: section.settings.image,
        fallback: section.settings.fallback,
        alt: section.settings.alt,
        sizes: media_sizes,
        eager: true
      -%}
    {%- endif -%}
  </div>
  {%- if section.settings.layout == 'full' -%}
    <div class="tib-hero__shade" style="--tib-overlay: {{ section.settings.overlay | divided_by: 100.0 }};"></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "TIBURNA Hero",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Aufteilung",
      "options": [
        { "value": "full", "label": "Vollbild (Bild hinter dem Text)" },
        { "value": "split", "label": "Geteilt (Text links, Bild rechts)" }
      ],
      "default": "full"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (optional)",
      "info": "Wenn ein Video gewählt ist, wird es statt des Bildes gezeigt – ohne Ton, in Endlosschleife."
    },
    {
      "type": "range",
      "id": "overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Abdunklung links (nur Vollbild)",
      "default": 55
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Bildbeschreibung",
      "default": "Spa-Badezimmer aus Travertin im warmen Abendlicht"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Leer lassen, um das Standardbild zu verwenden."
    },
    {
      "type": "text",
      "id": "fallback",
      "label": "Standardbild (Dateiname im Theme)",
      "default": "tiburna-rund.jpg"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überschrift",
      "default": "Badaccessoires aus Travertin"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Die Ruhe <em>des Steins.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Seifenspender, Zahnbürstenhalter und mehr – geformt aus echtem Travertin. Zeitlose Stücke, die Ihr Bad in einen Ort der Ruhe verwandeln.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Kollektion entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link",
      "default": "/collections/all"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "TIBURNA Hero"
    }
  ]
}
{% endschema %}
